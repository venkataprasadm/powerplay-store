{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Storage": { "Provider": "InMemory" },
  "Seed": { "Enabled": true },
  "Cors": { "AllowedOrigins": [] },
  "Auth": { "EnableDevTokens": false },
  "Jwt": { "Issuer": "powerplay-store", "Audience": "powerplay-store-api", "AccessTokenMinutes": 60 },
  "RateLimit": {
    "Enabled": true,
    "Search": { "PermitLimit": 120, "WindowSeconds": 60 },
    "Checkout": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "Store": { "MaxConcurrencyAttempts": 8 },
  "Shipping": { "FlatFee": 99, "FreeFrom": 999 },
  "Cosmos": { "Database": "iplstore", "StoreContainer": "store", "CartContainer": "carts", "TenantId": "ipl", "CreateIfNotExists": true, "Throughput": 400, "RequestTimeoutSeconds": 10 }
}
